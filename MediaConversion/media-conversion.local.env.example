# Copy this file to media-conversion.local.env beside convert.sh and add your real OMDb key.
# This example file is safe to commit; media-conversion.local.env is ignored by Git.
# Protect the local copy with chmod 600. Use only NAME=value lines; this is not a shell script.

OMDB_API_KEY=replace_with_your_key
OMDB_INTERACTIVE=1
OMDB_CONFIRM_CACHED=1
OMDB_REFRESH=0
STRICT_METADATA=0

JOBS=1
QSV_MODE=auto
QSV_LOW_POWER=0
FFMPEG_LOG_LEVEL=warning
VALIDATION_MODE=probe
HDR_MODE=preserve
EXISTING_POLICY=unique

AUDIO_MODE=surround+stereo
ALLOW_UNTAGGED_AUDIO_FALLBACK=1
ALLOW_COMMENTARY_AUDIO_FALLBACK=0
SUBTITLE_MODE=burn

KEEP_OMDB_SOURCE_SIDECAR=0
KEEP_OMDB_OUTPUT_SIDECAR=0
KEEP_OMDB_LOG=0
